DATABASE_URL=postgresql://edunets_app.PROJECT_REF:RUNTIME_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_POOL_MAX=5

# Admin app origin and a separate strong secret for its own session cookie.
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAILS=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-random-password

# Optional: use the same Google OAuth application as EduNets and add this app's
# /api/auth/callback/google URL to its authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
