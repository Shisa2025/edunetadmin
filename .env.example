DATABASE_URL=postgresql://edunets_app.PROJECT_REF:RUNTIME_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_POOL_MAX=5

# Admin app origin and a separate strong secret for its own session cookie.
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAILS=admin@example.com

# Use the same Google OAuth application as EduNets and add this app's
# /api/auth/callback/google URL to its authorized redirect URIs.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Optional local-only login. This path is disabled in production.
LOCAL_ADMIN_EMAIL=admin@local.test
LOCAL_ADMIN_PASSWORD=choose-a-local-password
